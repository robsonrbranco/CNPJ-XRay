# ===================================================================
# CNPJ-XRay — configuração
# Copie para .env e ajuste. O .env não vai para o repositório.
# ===================================================================

# ===================================================================
# BANCO DE DADOS (Firebird 3.0)
# ===================================================================

DB_HOST=localhost
DB_PORT=3050

# Caminho do .fdb COMO O SERVIDOR o enxerga — não como este processo o vê.
#   Windows nativo:  C:/CNPJ-XRay/bd/cnpj_xray.fdb
#   docker-compose:  /var/lib/firebird/data/cnpj_xray.fdb
DB_NAME=C:/CNPJ-XRay/bd/cnpj_xray.fdb

# Só quando o servidor enxerga o arquivo por um caminho diferente deste
# processo (Firebird em container ou noutra máquina). A troca blue-green
# renomeia arquivos, e quem renomeia é o Python, não o servidor.
FB_LOCAL_DATA_DIR=

DB_USER=SYSDBA
DB_PASSWORD=sua_senha_aqui

# Charset e collation do BANCO, definidos na criação e imutáveis depois
# (mudar exige backup/restore com gbak).
#
# WIN1252, não UTF8: a fonte é português do Brasil e cabe inteira em 1 byte
# por caractere. Medido, a base encolhe 27% — em 34 GB isso são ~9 GB, e menos
# banda em cada consulta.
#
# WIN_PTBR compara SEM ACENTO e SEM CAIXA: `ORDER BY razao_social` ordena
# certo em português, e `WHERE razao_social = 'JOSE'` acha `José`. O dado
# gravado continua fiel à fonte — a insensibilidade é da comparação.
DB_CHARSET=WIN1252
DB_COLLATION=WIN_PTBR

# Caminho da biblioteca cliente, se não estiver no PATH.
# Windows: C:/Program Files/Firebird/Firebird_3_0/fbclient.dll
# Linux:   /usr/lib/x86_64-linux-gnu/libfbclient.so.2
FB_CLIENT_LIBRARY=

# ===================================================================
# TUNING DE CARGA
# ===================================================================

# Tamanho de página. SÓ tem efeito na CRIAÇÃO do banco.
#
# Medido em 2026-09: page_size praticamente não muda o tamanho final (1,4 MB
# de diferença em 190 MB entre 4K, 8K e 16K). Como espaço é indiferente, 16384
# fica pelo outro critério — profundidade de índice e leitura sequencial.
# Detalhes no comentário de DEFAULT_PAGE_SIZE em src/db/config.py.
FB_PAGE_SIZE=16384

# Cache de páginas do banco, em MB.
#   0   = padrão do servidor
#   N   = N megabytes
#   -50 = metade da RAM física (negativo = percentual, limitado a 90%)
FB_CACHE_MB=2048

# Linhas por bloco enviado ao servidor. Maior = menos ida e volta, mais
# memória viva. 50.000 linhas de estabelecimento ~ 100 MB.
FB_BATCH_SIZE=50000

# Linhas por transação. Longa demais segura versão antiga das páginas e infla
# o banco; curta demais paga commit à toa.
FB_COMMIT_EVERY=500000

# Processos paralelos de carga. Paralelismo é por PROCESSO, não thread — as
# threads passam o tempo em Python e disputam o GIL.
ETL_PROCESSOS=8

# ===================================================================
# DOWNLOAD
# ===================================================================

# Onde as pastas de competência (AAAA-MM) são criadas. Apontando para a raiz,
# o ETL escolhe sozinho a competência mais recente que estiver em disco.
OUTPUT_FILES_PATH=./Download

# Tamanho de cada faixa Range. Grande o bastante para o handshake TLS sumir,
# pequeno o bastante para uma faixa travada não jogar fora muito trabalho.
DOWNLOAD_PEDACO_MB=64

# Conexões simultâneas. Medido contra o servidor da Receita: a banda satura em
# ~7 MB/s a partir de 2 conexões, e passar de 4 não compra nada.
DOWNLOAD_CONEXOES=4

# Minutos que um pedaço espera a origem voltar antes de desistir. O servidor da
# Receita cai e volta o tempo todo — na competência 2026-09 foram cerca de 595
# vezes em 15 horas.
DOWNLOAD_ESPERA_ORIGEM_MIN=180

# ===================================================================
# LOG
# ===================================================================

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ===================================================================
# PASSO A PASSO
# ===================================================================
#
# 1. Copie este arquivo:       cp .env.example .env
# 2. Defina DB_PASSWORD e confira DB_NAME.
# 3. Suba o servidor:          docker compose up -d      (ou use o Firebird local)
# 4. Instale:                  python -m pip install -e .
# 5. Baixe uma competência:    python -m src.etl.download
# 6. Construa a base:          python -m src.etl.pipeline --origem ./Download --switch
#
# Obrigatórias: DB_NAME, DB_PASSWORD.
# ===================================================================
