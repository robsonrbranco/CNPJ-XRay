# ===================================================================
# CNPJ-XRay — configuração
# Copie para .env e ajuste. O .env não vai para o repositório.
# ===================================================================

# ===================================================================
# BANCO DE DADOS (Firebird 3.0)
# ===================================================================

# Host e porta do servidor Firebird
DB_HOST=localhost
DB_PORT=3050

# Caminho do arquivo .fdb COMO O SERVIDOR o enxerga.
# Com o docker-compose deste repositório, o servidor vê /var/lib/firebird/data.
# Em servidor Windows nativo seria algo como C:/dados/cnpj_xray.fdb
DB_NAME=/var/lib/firebird/data/cnpj_xray.fdb

# Credenciais. SYSDBA é o administrador padrão do Firebird.
DB_USER=SYSDBA
DB_PASSWORD=sua_senha_aqui

# Charset da conexão. UTF8 porque razão social e nome fantasia têm acento.
DB_CHARSET=UTF8

# Caminho da biblioteca cliente, se não estiver no PATH.
# Windows: C:/Program Files/Firebird/Firebird_3_0/fbclient.dll
# Linux:   /usr/lib/x86_64-linux-gnu/libfbclient.so.2
FB_CLIENT_LIBRARY=

# ===================================================================
# TUNING DE CARGA
#
# O ganho de uma carga de dezenas de milhões de linhas em Firebird vem daqui.
# Ver docs/carga-firebird.md para o racional de cada parâmetro.
# ===================================================================

# Tamanho de página. 16384 é o máximo do Firebird 3.0 e o recomendado para
# esta base. SÓ tem efeito na CRIAÇÃO do banco — mudar depois exige gbak.
FB_PAGE_SIZE=16384

# Cache de páginas do banco, em MB.
#   0   = deixa o padrão do servidor
#   N   = N megabytes
#   -50 = metade da RAM física da máquina (valor negativo = percentual)
# Com página de 16 KB, 8000 MB equivalem a ~512.000 páginas.
FB_CACHE_MB=-50

# Linhas por chamada de executemany. Maior = menos ida e volta ao servidor,
# porém mais memória viva. 50.000 linhas de estabelecimento ~ 100 MB.
FB_BATCH_SIZE=50000

# Linhas por transação. Transação longa demais segura versão antiga das
# páginas e infla o banco; curta demais paga commit à toa.
FB_COMMIT_EVERY=500000

# ===================================================================
# CONFIGURAÇÕES OPCIONAIS
# ===================================================================

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timeout para operações (em segundos)
TIMEOUT=3600

# ===================================================================
# DOWNLOAD
# ===================================================================

DOWNLOAD_TIMEOUT=600
MAX_RETRIES=3
MAX_WORKERS=4

# ===================================================================
# DIRETÓRIOS
# ===================================================================

TEMP_DIR=./temp
LOG_DIR=./logs

# Onde os ZIP da Receita são baixados e onde os CSV são extraídos
OUTPUT_FILES_PATH=./Download
EXTRACTED_FILES_PATH=./dados/extracted

# ===================================================================
# PASSO A PASSO
# ===================================================================
#
# 1. Copie este arquivo:            cp .env.example .env
# 2. Defina DB_PASSWORD.
# 3. Suba o servidor:               docker compose up -d
# 4. Instale as dependências:       uv sync
# 5. Rode o ETL:                    uv run src/etl/ETL_dados_publicos_empresas.py
#
# Obrigatórias: DB_PASSWORD, OUTPUT_FILES_PATH, EXTRACTED_FILES_PATH
# ===================================================================
